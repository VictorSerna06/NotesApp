<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.NotesApp" parent="Theme.Material3.DayNight.NoActionBar">

        <!-- StatusBar -->
        <item name="statusBarBackground">@color/primary</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:windowLightStatusBar">false</item>

        <!-- Primary -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>

        <!-- Secondary -->
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorOnSecondary">@color/on_secondary</item>

        <!-- Surface -->
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/on_surface</item>

        <!-- Background -->
        <item name="background">@color/background</item>
        <item name="colorOnBackground">@color/on_background</item>

        <!-- Error -->
        <item name="colorErrorContainer">@color/error</item>
    </style>

    <style name="Theme.NotesApp" parent="Base.Theme.NotesApp" />

    <!-- SplashScreen -->
    <style name="Theme.NotesApp.SplashScreen" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/primary</item>
        <item name="postSplashScreenTheme">@style/Base.Theme.NotesApp</item>
    </style>
</resources>